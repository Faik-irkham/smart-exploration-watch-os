<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Izin untuk membaca sensor tubuh (heart rate) di Wear OS -->
    <uses-permission android:name="android.permission.BODY_SENSORS"/>

    <!-- Bluetooth: watch berperan sebagai peripheral yang mengiklankan data ke
         smartphone. Android 12+ (API 31) memakai izin runtime BLUETOOTH_ADVERTISE
         dan BLUETOOTH_CONNECT. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <!-- Izin Bluetooth lama untuk perangkat di bawah Android 12 (API 30). -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30"/>

    <!-- Foreground service agar pemantauan tetap berjalan saat app di-background
         atau layar mati. Tipe: health (sensor tubuh) + connectedDevice (BLE). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
    <!-- Menjaga CPU aktif saat layar mati agar sensor & timer tetap jalan. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Notifikasi permanen untuk foreground service (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Menandai aplikasi sebagai aplikasi jam tangan (Wear OS) -->
    <uses-feature android:name="android.hardware.type.watch"/>
    <!-- Membutuhkan Bluetooth Low Energy untuk mengirim data ke smartphone. -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true"/>

    <application
        android:label="HR FastFlush BLE"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Aplikasi Wear OS yang berdiri sendiri (tidak butuh app di ponsel
             untuk berjalan; data dikirim ke ponsel lewat BLE). -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true"/>
        <uses-library
            android:name="com.google.android.wearable"
            android:required="false"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Foreground service pemantauan (menjaga proses hidup di background). -->
        <service
            android:name=".MonitoringService"
            android:exported="false"
            android:foregroundServiceType="health|connectedDevice"/>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
