# Sampah sistem berkas macOS
.DS_Store

# Repositori publik hanya memuat kode sumber aplikasi dan berkas CSV hasil
# ekspor. Materi penulisan (naskah, catatan, skrip analisis, figur) disimpan
# di lokal saja.
/docs/
/hr_analysis/
/tools/
/figures/
*.docx
~$*.docx

# Artefak log eksperimen mentah
/watch_log*.txt
/mtu_*.txt

# Basis data biner hasil tarikan perangkat
# (berkas CSV hasil ekspornya tetap dilacak)
/watch.db
/phone.db
/watch.db-*
/phone.db-*

# Artefak build APK — dibuat ulang dengan `flutter build apk --release`
/apk/

# Data sesi uji coba instrumentasi (bukan data penelitian; naskah tidak
# merujuknya). Data 18 sesi resmi ada di /sesi/ dan tetap dilacak.
/uji*/
/uji*.log

# Materi penulisan tambahan: naskah PDF, tanggapan reviewer, serta berkas
# rujukan (persamaan dan paper pembanding). Hanya disimpan di lokal.
*.pdf
/RESPONSE-TO-REVIEWERS.md
/Ref-Equation/
/paper-rujukan-perbandingan/
